<?xml version="1.0" encoding="utf-8"?>
<com.example.videoapp.views.customviews.VideoPlayerView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/video_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:layout_gravity="center"
        tools:context=".views.activities.VideoPlayerActivity"
        android:orientation="vertical">

    <TextureView
            android:id="@+id/video_texture_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
            android:id="@+id/function_bar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:background="@color/function_bar_bg"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
                android:id="@+id/volume_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/volume_icon"
                android:layout_gravity="center"
                android:visibility="gone"/>
        <ImageView
                android:id="@+id/light_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/light_icon"
                android:layout_gravity="center"
                android:visibility="gone"/>
        <SeekBar
                android:id="@+id/function_seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"/>
    </LinearLayout>

    <LinearLayout
            android:id="@+id/video_function_bar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:background="@color/function_bar_bg"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        <TextView
                android:id="@+id/show_seek_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00/00:00"
                android:textColor="@color/white"/>

    </LinearLayout>

    <LinearLayout
            android:id="@+id/tool_bar_group"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:gravity="center_horizontal"
            android:layoutDirection="rtl"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
                android:id="@+id/horizontal_screen_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:src="@drawable/horizontal_screen"
                android:contentDescription="horizontal_screen_button"/>
        <ImageView
                android:id="@+id/vertical_screen_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:src="@drawable/vertical_screen"
                android:visibility="gone"
                android:contentDescription="vertical_screen_button"/>
        <TextView
                android:id="@+id/video_end_time"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:textColor="@color/white"
                android:textStyle="bold"/>
        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layoutDirection="ltr">
            <ImageView
                    android:id="@+id/video_played_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/video_paused"
                    android:contentDescription="video_played_image"/>
            <ImageView
                    android:id="@+id/video_paused_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/video_played"
                    android:visibility="gone"
                    android:contentDescription="video_paused_image"/>
            <TextView
                    android:id="@+id/video_start_time"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp"/>
            <SeekBar
                    android:id="@+id/video_seek_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

</com.example.videoapp.views.customviews.VideoPlayerView>