<?xml version="1.0" encoding="utf-8"?>
<com.example.videoapp.views.customviews.CustomCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/main_item_card_view_margin_start"
        android:layout_marginEnd="@dimen/main_item_card_view_margin_end"
        android:layout_marginTop="@dimen/main_item_card_view_margin_top"
        android:layout_marginBottom="@dimen/main_item_card_view_margin_bottom"
        app:cardCornerRadius="@dimen/video_item_radius"
        app:cardElevation="@dimen/main_item_card_view_card_elevation">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="UseCompoundDrawables">
        <com.example.videoapp.views.customviews.CustomImageView
                android:id="@+id/video_item_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black"
                app:whRatio="16:9"
                android:contentDescription="@string/video_item_image_desc"/>
        <TextView
                android:id="@+id/video_item_text"
                android:layout_width="match_parent"
                android:layout_height="@dimen/video_item_text_height"
                android:paddingTop="@dimen/main_item_text_view_padding_top"
                android:paddingStart="@dimen/main_item_text_view_padding_start"
                android:text="@string/video_item_text_default_str"
                tools:ignore="RtlSymmetry"/>
    </LinearLayout>

</com.example.videoapp.views.customviews.CustomCardView>