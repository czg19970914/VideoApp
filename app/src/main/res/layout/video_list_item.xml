<?xml version="1.0" encoding="utf-8"?>
<com.example.videoapp.views.customviews.CustomCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        app:cardCornerRadius="@dimen/video_item_radius"
        app:cardElevation="0dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="UseCompoundDrawables">
        <com.example.videoapp.views.customviews.CustomImageView
                android:id="@+id/video_item_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black"
                app:whRatio="16:7"
                android:contentDescription="@string/video_item_image_desc"/>
        <TextView
                android:id="@+id/video_item_text"
                android:layout_width="match_parent"
                android:layout_height="@dimen/video_item_text_height"
                android:text="@string/video_item_text_default_str"/>
    </LinearLayout>

</com.example.videoapp.views.customviews.CustomCardView>